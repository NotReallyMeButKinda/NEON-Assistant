{
  "manifest_version": 2,
  "name": "NEON Assistant Bridge",
  "version": "1.0.0",
  "description": "Lets your NEON desktop assistant read the page you're on, answer questions about it, and switch or close tabs. Talks only to NEON on this PC (127.0.0.1).",
  "browser_specific_settings": {
    "gecko": {
      "id": "neon-bridge@neon-assistant.local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/neon-16.png",
    "32": "icons/neon-32.png",
    "48": "icons/neon-48.png",
    "96": "icons/neon-96.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/neon-16.png",
      "32": "icons/neon-32.png"
    },
    "default_title": "NEON: not connected",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}